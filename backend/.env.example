SECRET_KEY=please-change-me
DATABASE_URL=sqlite:///./data/app.db
# 生产示例（云数据库）:
# DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/welfare
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://localhost:5173,https://127.0.0.1:5173
ACCESS_TOKEN_EXPIRE_MINUTES=1440
LIVE_CODE_EXPIRE_SECONDS=30

# ---------- 腾讯企业邮 / 企业微信邮箱 SMTP（推荐 465 + SSL）----------
# 管理端：https://exmail.qq.com/ → 设置 → 客户端设置 → 开启 SMTP
# 或企业微信管理后台 → 邮件 → 客户端专用密码
MAIL_SERVER=smtp.exmail.qq.com
MAIL_PORT=465
MAIL_SSL_TLS=true
MAIL_STARTTLS=false
MAIL_USERNAME=noreply@your-company.com
MAIL_PASSWORD=你的邮箱密码或客户端专用密码
MAIL_FROM=noreply@your-company.com
MAIL_FROM_NAME=青年福利券系统
# 真实 SMTP 开启后请保持 false（不要把验证码返回给前端）
MAIL_CONSOLE=false
EMAIL_CODE_EXPIRE_MINUTES=10

# 备选：587 + STARTTLS（若 465 被墙/公司网络限制）
# MAIL_PORT=587
# MAIL_SSL_TLS=false
# MAIL_STARTTLS=true

# ---------- QQ 邮箱示例 ----------
# MAIL_SERVER=smtp.qq.com
# MAIL_PORT=465
# MAIL_SSL_TLS=true
# MAIL_STARTTLS=false
# MAIL_USERNAME=you@qq.com
# MAIL_PASSWORD=授权码

