# ---------- 环境 ----------
# development | production（生产会默认关 OpenAPI / 演示 seed / 局域网 CORS）
APP_ENV=development

# JWT 签名密钥（生产必须换成长随机串，禁止默认值）
SECRET_KEY=please-change-me-to-a-long-random-string

# 银行卡等字段加密密钥（与 JWT 分离；生产强烈建议设置）
# 未设置时回退 SECRET_KEY 并打 deprecation 警告
FIELD_ENCRYPTION_KEY=
# 轮换时保留旧密钥以便解密历史密文（可选）
FIELD_ENCRYPTION_KEY_PREVIOUS=

# 开发默认 SQLite；Ubuntu 生产用 MySQL（见 deploy/）
DATABASE_URL=sqlite:///./data/app.db
# MySQL 示例（密码中的 @ # 等请 URL 编码）:
# DATABASE_URL=mysql+pymysql://welfare:CHANGE_ME@127.0.0.1:3306/welfare?charset=utf8mb4

# ---------- CORS ----------
# 生产只写正式 https 域名，逗号分隔
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://localhost:5173,https://127.0.0.1:5173
# 是否允许局域网 Origin 正则（开发默认 true，生产默认 false）
CORS_ALLOW_LAN=true

# ---------- 生产开关（可显式覆盖 APP_ENV 默认）----------
# OPENAPI_ENABLED=false
# SEED_DEMO_ACCOUNTS=false
# CORS_ALLOW_LAN=false

ACCESS_TOKEN_EXPIRE_MINUTES=1440
LIVE_CODE_EXPIRE_SECONDS=30

# ---------- 登录限流 ----------
# auto | memory | file | redis（auto：有 REDIS_URL 用 redis；生产默认 file；开发 memory）
RATE_LIMIT_BACKEND=auto
# REDIS_URL=redis://127.0.0.1:6379/0
RATE_LIMIT_FILE_PATH=./data/rate_limit.db
LOGIN_MAX_FAILS=8
LOGIN_WINDOW_SECONDS=300
# 全局限流（每 IP / 窗口）；0 关闭
GLOBAL_IP_MAX_REQUESTS=300
GLOBAL_IP_WINDOW_SECONDS=60

# ---------- 腾讯企业邮 SMTP（推荐 465 + SSL）----------
MAIL_SERVER=smtp.exmail.qq.com
MAIL_PORT=465
MAIL_SSL_TLS=true
MAIL_STARTTLS=false
MAIL_USERNAME=noreply@your-company.com
MAIL_PASSWORD=
MAIL_FROM=noreply@your-company.com
MAIL_FROM_NAME=青年福利券系统
MAIL_CONSOLE=false
EMAIL_CODE_EXPIRE_MINUTES=10

# ---------- 生产示例片段 ----------
# APP_ENV=production
# SECRET_KEY=<openssl rand -hex 32>
# FIELD_ENCRYPTION_KEY=<openssl rand -hex 32>
# OPENAPI_ENABLED=false
# SEED_DEMO_ACCOUNTS=false
# CORS_ALLOW_LAN=false
# CORS_ORIGINS=https://coupon.example.com
# DATABASE_URL=mysql+pymysql://welfare:...@127.0.0.1:3306/welfare?charset=utf8mb4
# RATE_LIMIT_BACKEND=redis
# REDIS_URL=redis://127.0.0.1:6379/0
