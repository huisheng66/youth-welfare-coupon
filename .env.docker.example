# ============================================================
# Docker 部署环境变量示例
# 用法：cp .env.docker.example .env，按需修改后 docker compose up -d
# ============================================================

# ---------- 环境 ----------
# 容器内默认走生产模式（alembic 迁移 + 关 OpenAPI + 关演示 seed）
APP_ENV=production

# JWT 签名密钥（生产必须换成长随机串，禁止默认值）
# 生成：openssl rand -hex 32
SECRET_KEY=please-change-me-to-a-long-random-string

# 银行卡等字段加密密钥（与 JWT 分离；生产强烈建议设置）
# 生成：openssl rand -hex 32
FIELD_ENCRYPTION_KEY=
# 轮换时保留旧密钥以便解密历史密文（可选）
FIELD_ENCRYPTION_KEY_PREVIOUS=

# 数据库：容器内默认 SQLite（走 volume 持久化）；
# 如用外部 MySQL，注释掉 compose 中 DATABASE_URL 环境变量，改用下方：
# DATABASE_URL=mysql+pymysql://welfare:CHANGE_ME@mysql:3306/welfare?charset=utf8mb4

# ---------- CORS ----------
# 生产只写正式 https 域名，逗号分隔
# 容器内前端通过 nginx 反代 /api 到后端，同源，CORS 通常无需放开跨域
CORS_ORIGINS=https://coupon.example.com
# 生产关闭局域网 CORS
CORS_ALLOW_LAN=false

# ---------- 生产开关 ----------
OPENAPI_ENABLED=false
SEED_DEMO_ACCOUNTS=false

ACCESS_TOKEN_EXPIRE_MINUTES=1440
LIVE_CODE_EXPIRE_SECONDS=30

# ---------- 登录限流 ----------
# 容器内已配 RATE_LIMIT_BACKEND=redis + REDIS_URL，无需在此重复
# 如用外部 Redis，注释掉 compose 中对应环境变量，改用：
# RATE_LIMIT_BACKEND=redis
# REDIS_URL=redis://your-redis-host:6379/0
LOGIN_MAX_FAILS=8
LOGIN_WINDOW_SECONDS=300
# 全局限流（每 IP / 窗口）；0 关闭
GLOBAL_IP_MAX_REQUESTS=300
GLOBAL_IP_WINDOW_SECONDS=60

# ---------- 腾讯企业邮 SMTP（推荐 465 + SSL）----------
MAIL_SERVER=smtp.exmail.qq.com
MAIL_PORT=465
MAIL_SSL_TLS=true
MAIL_STARTTLS=false
MAIL_USERNAME=noreply@your-company.com
MAIL_PASSWORD=
MAIL_FROM=noreply@your-company.com
MAIL_FROM_NAME=青年福利券系统
MAIL_CONSOLE=false
EMAIL_CODE_EXPIRE_MINUTES=10

# ---------- 腾讯企业邮 IMAP（收信，SSL 993；与 SMTP 共用账号密码）----------
IMAP_SERVER=imap.exmail.qq.com
IMAP_PORT=993
IMAP_SSL=true
