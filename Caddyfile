# Caddy 2 配置：自动 HTTPS + 反代到 web 容器
# {$WELFARE_DOMAIN} 从 .env 读取，例如 coupon.example.com
#
# Caddy 会自动：
#   1. 向 Let's Encrypt 申请证书（首次访问触发）
#   2. 自动续期（到期前 30 天）
#   3. 80 端口所有请求跳转到 443

{$WELFARE_DOMAIN} {
	# 反代到 web 容器（compose service name = web，端口 8080）
	reverse_proxy web:8080

	# 压缩文本类响应
	encode gzip zstd

	# 安全响应头（与 nginx/FastAPI 中间件三层叠加）
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		# 移除暴露版本号的响应头
		-Server
	}

	# 访问日志到 stdout（docker logs caddy 可查）
	log {
		output stdout
		format console
		level INFO
	}
}
